# Local development settings for running the API outside Docker (copy to backend/.env).
AGROAI_ENVIRONMENT=development
AGROAI_DATABASE_URL=postgresql+psycopg://agroai:agroai@localhost:5432/agroai
AGROAI_SECRET_KEY=insecure-development-key-change-me
AGROAI_ACCESS_TOKEN_EXPIRE_MINUTES=60
AGROAI_CORS_ORIGINS=http://localhost:5173
AGROAI_LOG_LEVEL=INFO
