# Copy to .env and adjust. Never commit the real .env.

# Required: a long random string used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AGROAI_SECRET_KEY=

# Database password for the bundled PostgreSQL container.
POSTGRES_PASSWORD=agroai

# Comma-separated origins allowed to call the API directly from a browser.
AGROAI_CORS_ORIGINS=http://localhost:8080

AGROAI_LOG_LEVEL=INFO
