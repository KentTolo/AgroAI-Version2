# Copy to .env and fill in. Never commit .env.

# Tailscale auth key (https://login.tailscale.com/admin/settings/keys): reusable, not ephemeral.
TS_AUTHKEY=tskey-auth-...

# Protects WAHA's API. AgroAI sends it as X-Api-Key (AGROAI_WAHA_API_KEY on Render).
WAHA_API_KEY=change-me-long-random
# Login for WAHA's dashboard, where you scan the QR code.
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=change-me-too
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=change-me-too

# Where incoming messages go, and the key that signs them
# (AGROAI_WAHA_WEBHOOK_HMAC_KEY on Render).
WHATSAPP_HOOK_URL=https://agroai-api-c9cq.onrender.com/api/v1/whatsapp/webhook
WHATSAPP_HOOK_HMAC_KEY=change-me-another-long-random
